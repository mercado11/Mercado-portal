# ===== Copiez ces variables dans Render > Environment (ne mettez JAMAIS .env sur GitHub) =====

# --- Adresse publique du site (OBLIGATOIRE pour le webhook de paiement) ---
PUBLIC_BASE_URL=https://VOTRE-SERVICE.onrender.com
CORS_ORIGIN=*

# --- Produits : CJ Dropshipping (OBLIGATOIRE) ---
# CJ > My CJ > Authorization > API > generer la cle
CJ_API_KEY=
USD_EUR_RATE=0.92
# Ignore les articles CJ moins chers que ce prix (USD), souvent inutilisables
MIN_CJ_PRICE_USD=0.5

# --- Marge cachee ---
# Marge fixe en DOLLARS ajoutee au prix CJ (puis converti en euros)
PRICE_MARKUP_USD=5
# Minimum de produits (les moins chers) affiches par categorie
MIN_PRODUCTS_PER_CATEGORY=20

# --- Paiement : CamerPay (laisser CAMERPAY_TOKEN vide = site "paiement bientot disponible") ---
CAMERPAY_TOKEN=
# test = messages Telegram marques TEST (par defaut). Passer a live seulement en production.
CAMERPAY_MODE=test
CAMERPAY_BASE_URL=https://camerpay.biz/api
CAMERPAY_INITIATE_PATH=/payments/initiate
CAMERPAY_STATUS_PATH=/payments/{id}/status
CAMERPAY_CURRENCY=XAF
EUR_RATE=655.957
# Vide = le client choisit sur la page CamerPay
CAMERPAY_METHOD=
# Page affichee apres paiement (optionnel)
FRONTEND_SUCCESS_URL=

# --- Commandes recues sur Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Emails (code de verification, confirmations) : Resend ---
RESEND_API_KEY=
RESEND_FROM=MERCADO <onboarding@resend.dev>

# --- Assistant IA + recherche par photo (optionnel) ---
ANTHROPIC_API_KEY=

# --- Traduction auto des langues non incluses (optionnel, une seule des deux) ---
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# --- Admin ---
ADMIN_KEY=choisissez-un-long-mot-de-passe
REMINDER_DELAY_HOURS=24
