# Copiez ces variables dans Render > Environment. Ne publiez jamais de vraies clés.
PUBLIC_BASE_URL=https://VOTRE-SERVICE.onrender.com
CORS_ORIGIN=*
DATA_DIR=/opt/render/project/src/data

# CJ Dropshipping
CJ_API_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
CJ_DAILY_POINTS_LIMIT=40000
CJ_CACHE_HOURS=6
MIN_CJ_PRICE_USD=0.5
MIN_PRODUCTS_PER_CATEGORY=20
PRICE_MARKUP_USD=5
# Laisser vide pour utiliser le taux automatique
USD_EUR_RATE=

# CamerPay : ne pas activer le paiement réel avant d'avoir validé le compte et les callbacks
CAMERPAY_TOKEN=
CAMERPAY_CALLBACK_SECRET=
CAMERPAY_MODE=test
CAMERPAY_BASE_URL=https://camerpay.biz/api
CAMERPAY_INITIATE_PATH=/payment/initiate
CAMERPAY_STATUS_PATH=/payment/{id}/status
CAMERPAY_CURRENCY=XAF
EUR_RATE=655.957
CAMERPAY_METHOD=
FRONTEND_SUCCESS_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend — onboarding@resend.dev est réservé aux essais; pour les clients, vérifiez votre domaine
RESEND_API_KEY=
RESEND_FROM=MERCADO <onboarding@resend.dev>

# Options
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
ADMIN_KEY=REMPLACER_PAR_UN_SECRET_LONG_ALEATOIRE
