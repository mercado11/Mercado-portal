# ============================================
# À copier dans Render > votre service > Environment
# (jamais dans le code, jamais dans mercado.html)
# ============================================

PORT=10000

# Origine exacte de votre site (pour CORS). Mettez * en dev.
CORS_ORIGIN=*

# ---------- EMAIL (code de vérification + notifications) ----------
# Option recommandée : Resend (le plus simple, une seule clé API)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "from" doit utiliser un domaine vérifié dans Resend, sinon laissez
# la valeur de test ci-dessous (limitée, mais fonctionne sans réglage)
RESEND_FROM="MERCADO <onboarding@resend.dev>"

# Option alternative : SMTP classique (utilisée seulement si
# RESEND_API_KEY n'est pas défini) — exemple avec Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM="MERCADO <votre-adresse@gmail.com>"

# ---------- TELEGRAM (canal prioritaire pour recevoir les commandes) ----------
# Le plus simple à mettre en place :
# 1. Vous avez déjà créé le bot avec BotFather -> vous avez le token.
# 2. Envoyez UN message à votre bot depuis Telegram (cherchez son nom, /start).
# 3. Ouvrez dans un navigateur :
#    https://api.telegram.org/bot<VOTRE_TOKEN>/getUpdates
#    -> repérez "chat":{"id": ...} dans la réponse, c'est TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxx

# ---------- WHATSAPP (repli si Telegram/Messenger non configurés) ----------
# Compte Twilio > WhatsApp Sandbox ou numéro WhatsApp Business validé
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Numéro qui reçoit les commandes (format international, sans espaces)
WHATSAPP_TO=whatsapp:+237697428505

# ---------- FACEBOOK MESSENGER (canal prioritaire pour recevoir les commandes) ----------
# 1. Créez une app sur developers.facebook.com > Messenger > ajoutez votre Page
# 2. Générez un "Page Access Token" (permanent, dans les réglages Messenger de l'app)
# 3. Envoyez-vous UN message depuis votre compte perso vers votre propre Page
#    (juste pour que Facebook crée votre PSID)
# 4. Récupérez votre PSID via :
#    https://graph.facebook.com/v19.0/me/conversations?fields=participants&access_token=VOTRE_PAGE_TOKEN
FB_PAGE_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FB_ADMIN_PSID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- FLUTTERWAVE (carte, Apple Pay, Google Pay, Mobile Money) ----------
# Licencié pour opérer au Cameroun (BEAC). Verse en XAF sur le compte
# bancaire du titulaire (jamais sur un wallet crypto).
# Créez un compte sur flutterwave.com > Settings > API pour les clés.
# Pour tester SANS vrai argent : activez le mode Test sur le dashboard
# et utilisez une clé qui commence par FLWSECK_TEST- (pas FLWSECK-).
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Devise du compte marchand (XAF pour un compte camerounais)
FLUTTERWAVE_CURRENCY=XAF
# Pour vérifier les webhooks (Settings > Webhooks sur le dashboard,
# mettez la même valeur des deux côtés)
FLW_SECRET_HASH=change-moi-aussi

PUBLIC_BASE_URL=https://votre-backend.onrender.com
# Flutterwave n'a qu'une seule URL de retour (succès et échec y renvoient
# tous les deux ; le statut est lu dans les paramètres de l'URL)
FRONTEND_SUCCESS_URL=https://votre-site.com/#confirm

# ---------- EBAY (catalogue réel, change selon le pays du client) ----------
# Créez une app sur developer.ebay.com > Application Keys (production)
EBAY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EBAY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Si absent, le site utilise data/products.json (mode démo)

# ---------- IA — MERCADO AI (assistant type "mini Meta AI") ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- TRADUCTION (langues sans dictionnaire intégré) ----------
# Une seule des deux suffit
DEEPL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx:fx
GOOGLE_TRANSLATE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- MARGE MERCADO ----------
# Montant ajouté (en $/€) sur le prix de chaque produit affiché et
# vendu sur MERCADO, par rapport au prix eBay d'origine. 6 par défaut.
PRICE_MARKUP=6

# ---------- ADMIN ----------
# Clé secrète pour déclencher l'envoi des emails "produit disponible"
# et pour forcer manuellement l'envoi des rappels "vous avez consulté..."
ADMIN_KEY=change-moi

# Délai avant l'envoi d'un rappel "vous avez récemment consulté..."
# (en heures). 24 = un jour. Un seul rappel par produit et par client.
REMINDER_DELAY_HOURS=24
